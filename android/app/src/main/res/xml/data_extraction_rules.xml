<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer. Same exclusions as
     backup_rules.xml — plaintext originals must not leave the app sandbox. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="evidence_cache" />
        <exclude domain="file" path="trust_package_exports" />
        <exclude domain="root" path="app_flutter/evidence_cache" />
        <exclude domain="root" path="app_flutter/trust_package_exports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="evidence_cache" />
        <exclude domain="file" path="trust_package_exports" />
        <exclude domain="root" path="app_flutter/evidence_cache" />
        <exclude domain="root" path="app_flutter/trust_package_exports" />
    </device-transfer>
</data-extraction-rules>
